{
  "name": "perse-remote-dev",
  "version": "0.3.1-rc.7",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "description": "perse-remote-dev: PC connection settings and native DSH remote sessions through the private owner-Remote bridge to Perse Remote 1.2",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/index.d.ts",
    "lib/types/settings.d.ts",
    "lib/types/types.d.ts",
    "lib/types/types.js",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts",
    "client.js",
    "engine/rd-sync.sh",
    "cordis.patch.yml",
    "LICENSE",
    "README.md",
    "README.zh.md",
    "docs/**/*.md",
    "docs/**/*.json"
  ],
  "dsh": {
    "bundle": {
      "patch": "cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "external": [
        "@deepseek-ai/dsh-api-session-controller/client"
      ],
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-api-session-controller"
      ]
    }
  },
  "scripts": {
    "build": "cd ../.. && npm run build"
  },
  "dependencies": {
    "@deepseek-ai/cosmokit": "~1.8.6",
    "ws": "^8.22.0",
    "yaml": "^2.9.1",
    "zod": "^4"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-api-session-controller": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "^0.2.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-api-session-controller": {
      "optional": true
    }
  },
  "license": "MIT",
  "devDependencies": {
    "@deepseek-ai/dsh-client-ui-settings": "0.2.1-rc.2"
  }
}
