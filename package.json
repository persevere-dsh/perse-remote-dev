{
  "name": "perse-remote-dev-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Build workspace for perse-remote-dev — an out-of-tree DSH remote-development plugin of Persevere with DSH. The installable package lives in packages/perse-remote-dev.",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "contracts": "node scripts/sync-pc-contracts.mjs",
    "setup:dsh-native": "node scripts/setup-dsh-native.mjs",
    "pretypecheck": "npm run codegen && node scripts/verify-native-types.mjs && node scripts/clean-types.mjs",
    "typecheck": "tsc -b tsconfig.host.json --force",
    "codegen": "node scripts/gen-typert.mjs",
    "import:native-types": "node scripts/import-native-types.mjs",
    "verify:native-types": "node scripts/verify-native-types.mjs",
    "build": "npm run contracts && npm run typecheck && npm run bundle && npm run bundle:client",
    "bundle": "tsdown",
    "bundle:client": "tsdown --config tsdown.client.config.ts",
    "pack": "npm run build && npm pack --workspace perse-remote-dev",
    "test": "npm run build && node scripts/verify-generated.mjs && node scripts/verify-client-bundle.mjs && node scripts/verify-host-surface.mjs && node --experimental-transform-types --test test/pc-*.mjs",
    "verify:generated": "node scripts/verify-generated.mjs",
    "verify:client": "node scripts/verify-client-bundle.mjs",
    "verify:surface": "node scripts/verify-host-surface.mjs",
    "test:pc-ui": "vitest run test/pc-ui.native.test.tsx"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-api-gateway": "0.2.1-rc.2",
    "@deepseek-ai/dsh-api-session-controller": "0.2.1-rc.2",
    "@deepseek-ai/dsh-attachment": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-locale": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-store": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-layout": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.1-rc.2",
    "@deepseek-ai/dsh-commands": "0.2.1-rc.2",
    "@deepseek-ai/dsh-file-reference": "0.2.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.2",
    "@deepseek-ai/dsh-native-command": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session-projection": "0.2.1-rc.2",
    "@deepseek-ai/dsh-subagent": "0.2.1-rc.2",
    "@deepseek-ai/dsh-typert-generator": "0.2.1-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "0.2.1-rc.2",
    "@deepseek-ai/dsh-workspace": "0.2.1-rc.2",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "18.3.27",
    "@types/ws": "^8.18.2",
    "clsx": "2.1.1",
    "jsdom": "27.0.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "tsdown": "^0.22.2",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
