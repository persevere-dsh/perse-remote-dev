{
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "composite": true,
    "incremental": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": false,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "skipLibCheck": true,
    "ignoreDeprecations": "6.0",
    "paths": {
      "@deepseek-ai/dsh-api-session-controller/client": ["./vendor/native-dsh-session-controller-types/lib/types/client/index.d.ts"],
      "@deepseek-ai/dsh-api-session-controller/types": ["./vendor/native-dsh-session-controller-types/lib/types/types.d.ts"],
      "@deepseek-ai/dsh-api-session-controller/remote": ["./vendor/native-dsh-session-controller-types/lib/typert.remote-client.d.ts"]
    }
  }
}
