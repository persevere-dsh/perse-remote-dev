# @deepseek-ai/dsh-typert-protocol is a RUNTIME PEER of this out-of-tree plugin:
# the host must supply it so the plugin and the harness share one module instance
# (a second copy silently disables the Remote layer).
# npm >= 7 auto-installs peers, which would place a duplicate in ./node_modules,
# so peer auto-install is disabled here on purpose.
legacy-peer-deps=true
